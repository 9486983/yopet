<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="XamlDemoPlugin.Views.DemoPanel"
             x:CompileBindings="False"
             Width="360">
  <arc:Card Title="XAML Demo"
            Description="This panel is compiled from .axaml into the plugin DLL and hosted inside the pet bubble.">
    <StackPanel Spacing="12">
      <arc:Input x:Name="Input"
                 Label="Message"
                 Placeholder="Type something" />
      <TextBlock Text="{Binding Message}"
                 TextWrapping="Wrap"
                 FontSize="{arc:ArcDesignTokenResource TypeSM}"
                 Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <arc:Button Content="Send message" Click="OnButtonClick" />
      </StackPanel>
      <TextBlock Text="Use the close button at the top right when you are done."
                 TextWrapping="Wrap"
                 FontSize="{arc:ArcDesignTokenResource TypeXS}"
                 Foreground="{arc:ArcDesignTokenResource TextMuted}"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </arc:Card>
</UserControl>
