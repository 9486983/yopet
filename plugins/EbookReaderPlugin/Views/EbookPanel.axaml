<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:primitives="using:Avalonia.Controls.Primitives"
             x:Class="EbookReaderPlugin.Views.EbookPanel"
             x:CompileBindings="False"
             Width="408"
             Height="548"
             Focusable="True"
             Background="Transparent"
             PointerPressed="OnRootSurfacePressed"
             KeyDown="OnRootKeyDown">
  <Border x:Name="RootBorder"
          Margin="24"
          BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}"
          PointerMoved="OnReaderPointerMoved"
          PointerWheelChanged="OnReaderWheel"
          Background="{arc:ArcDesignTokenResource SurfaceRaised}"
          BorderBrush="{arc:ArcDesignTokenResource Border}"
          BorderThickness="1"
          CornerRadius="16"
          ClipToBounds="False">
    <Grid x:Name="FormLayout" RowDefinitions="44,*">
      <Grid x:Name="FormChrome"
            Grid.Row="0"
            Background="Transparent"
            PointerPressed="OnFormChromePointerPressed">
        <Border x:Name="ReaderHeaderOverlay"
                IsVisible="False"
                Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                CornerRadius="15,15,0,0"
                ClipToBounds="True">
          <Grid ColumnDefinitions="Auto,*,32" Margin="10,0">
            <arc:Button x:Name="ReaderBackButton"
                        Variant="Ghost"
                        Size="Small"
                        Width="32" Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnBackClick">
              <lucide:LucideIcon x:Name="ReaderBackIcon" Kind="ChevronLeft" Size="16" Foreground="{arc:ArcDesignTokenResource Foreground}" />
            </arc:Button>
            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
              <TextBlock x:Name="ReaderTitle"
                         Text="书名"
                         FontSize="{arc:ArcDesignTokenResource TypeBase}"
                         FontWeight="SemiBold"
                         Foreground="{arc:ArcDesignTokenResource Foreground}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="RootContent" Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="14,0,14,12">

      <!-- 顶部栏 -->
      <Border x:Name="HeaderPanel"
              Grid.Row="0"
              Background="{arc:ArcDesignTokenResource SurfaceRaised}"
              BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="8,6"
              Margin="0,0,0,10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <arc:Button x:Name="BackButton"
                      Variant="Ghost"
                      Size="Small"
                      Width="32" Height="32"
                      Padding="0"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      IsVisible="False"
                      Click="OnBackClick">
            <lucide:LucideIcon Kind="ChevronLeft" Size="18" Foreground="{arc:ArcDesignTokenResource Foreground}" />
          </arc:Button>

          <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="HeaderTitle"
                       Text="书架"
                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                       FontWeight="SemiBold"
                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="HeaderSubtitle"
                       Text="点击封面开始阅读"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <arc:SegmentedControl x:Name="ShelfModeControl"
                                Grid.Column="2"
                                Width="126"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                SelectionChanged="OnShelfModeChanged" />

          <arc:Button x:Name="ImportButton"
                      Grid.Column="3"
                      Variant="Primary"
                      Size="Small"
                      Click="OnImportClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <lucide:LucideIcon Kind="Plus" Size="14" Foreground="#FFFFFF" />
              <TextBlock x:Name="ImportButtonText" Text="导入" VerticalAlignment="Center" />
            </StackPanel>
          </arc:Button>
        </Grid>
      </Border>

      <!-- 主体 -->
      <Grid Grid.Row="1">

        <!-- 书架 -->
        <Grid x:Name="LibraryPanel">
          <Border x:Name="ShelfSurface"
                  Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                  BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="10"
                  ClipToBounds="True">
            <ScrollViewer x:Name="ShelfScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ShelfHost" Spacing="10" Margin="10" />
            </ScrollViewer>
          </Border>

          <Border x:Name="EmptyState"
                  IsVisible="False"
                  Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                  BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="24,18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <lucide:LucideIcon Kind="LibraryBig" Size="42"
                                 Foreground="{arc:ArcDesignTokenResource Accent}"
                                 HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyTitleText"
                         Text="书架还是空的"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{arc:ArcDesignTokenResource Foreground}"
                         HorizontalAlignment="Center" />
              <TextBlock x:Name="EmptyHintText"
                         Text="把电子书拖到宠物上，或点击下方按钮导入"
                         FontSize="11"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="240" />
              <arc:Button x:Name="EmptyImportButton"
                          Content="导入电子书"
                          Variant="Primary"
                          Size="Small"
                          HorizontalAlignment="Center"
                          Margin="0,4,0,0"
                          Click="OnImportClick" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- 阅读器 -->
        <Border x:Name="ReaderPanel"
                IsVisible="False"
                Background="Transparent">
          <Border x:Name="PageFrame"
                  Background="Transparent"
                  BorderThickness="0"
                  ClipToBounds="True">
            <Grid>
              <Grid x:Name="PageContentGrid"
                    Margin="18,8"
                    RowDefinitions="Auto,*"
                    SizeChanged="OnPageContentSizeChanged">
                <Border x:Name="PageImageFrame"
                        Grid.Row="0"
                        IsVisible="False"
                        IsHitTestVisible="False"
                        Margin="0,0,0,8"
                        ClipToBounds="True">
                  <Image x:Name="PageImage"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Border>
                <SelectableTextBlock x:Name="PageText"
                                     Grid.Row="1"
                                     FontSize="16"
                                     LineHeight="27"
                                     Foreground="#2B2620"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch" />
              </Grid>
              <TextBlock x:Name="PageChapterHeading"
                         IsVisible="False"
                         IsHitTestVisible="False"
                         Margin="18,8,18,0"
                         FontSize="20"
                         FontWeight="SemiBold"
                         LineHeight="30"
                         Foreground="#2B2620"
                         TextAlignment="Center"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top" />
              <Border x:Name="LeftZone"
                      Width="24"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      Cursor="Hand"
                      PointerPressed="OnLeftZonePressed">
                <TextBlock x:Name="LeftZoneHint"
                           Text="‹"
                           FontSize="22"
                           Foreground="#8B6B3E"
                           Opacity="0.28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <Border x:Name="RightZone"
                      Width="24"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      Cursor="Hand"
                      PointerPressed="OnRightZonePressed">
                <TextBlock x:Name="RightZoneHint"
                           Text="›"
                           FontSize="22"
                           Foreground="#8B6B3E"
                           Opacity="0.28"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>

              <Border x:Name="SelectionToolbar"
                      IsVisible="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,12"
                      Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                      BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}"
                      BorderBrush="{arc:ArcDesignTokenResource Border}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="4"
                      PointerPressed="OnSelectionToolbarPressed">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <arc:Button x:Name="HighlightSelectionButton"
                              Content="高亮"
                              Variant="Secondary"
                              Size="Small"
                              Click="OnHighlightSelectionClick" />
                  <arc:Button x:Name="AnnotateSelectionButton"
                              Content="批注"
                              Variant="Secondary"
                              Size="Small"
                              Click="OnAnnotateSelectionClick" />
                  <arc:Button x:Name="CancelSelectionButton"
                              Content="取消"
                              Variant="Ghost"
                              Size="Small"
                              Click="OnCancelSelectionClick" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Border>
      </Grid>

      <!-- 书架底部提示 -->
      <TextBlock x:Name="LibraryFooter"
                 Grid.Row="2"
                 Text="单击阅读 · 右键管理 · 滚轮浏览"
                 FontSize="{arc:ArcDesignTokenResource TypeXS}"
                 Foreground="{arc:ArcDesignTokenResource TextMuted}"
                 HorizontalAlignment="Center"
                 Margin="0,8,0,0" />

      <!-- 阅读器底部工具栏 + 设置（悬浮在正文之上） -->
      <Border x:Name="ReaderStatusBar"
              Grid.Row="2"
              IsVisible="False"
              Background="{arc:ArcDesignTokenResource SurfaceRaised}"
              BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              CornerRadius="8"
              Padding="10,4"
              Margin="4,4,4,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ReaderChapterTitle"
                     Text="章节"
                     FontSize="10"
                     Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center">
            <TextBlock x:Name="PageInfoText"
                       Text="1 / 1"
                       FontSize="10"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <TextBlock x:Name="ProgressText"
                       Text="0%"
                       FontSize="10"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="ReaderFooter"
              Grid.Row="1"
              IsVisible="False"
              Opacity="0"
              VerticalAlignment="Bottom"
              Background="{arc:ArcDesignTokenResource SurfaceRaised}"
              BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}"
              BorderBrush="{arc:ArcDesignTokenResource Border}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="12,10"
              Margin="4,0,4,4">
        <StackPanel Spacing="8">

          <StackPanel x:Name="SettingsStrip" IsVisible="False" Spacing="8">
            <Grid ColumnDefinitions="56,*">
              <TextBlock x:Name="FontLabelText"
                         Text="字体"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                         VerticalAlignment="Center" />
              <arc:Select x:Name="FontSelect"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Size="Small"
                          SelectionChanged="OnFontFamilyChanged" />
            </Grid>

            <Grid ColumnDefinitions="56,*">
              <TextBlock x:Name="FontSizeLabelText"
                         Text="字号"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="4"
                          VerticalAlignment="Center">
                <arc:Button x:Name="FontSizeDecreaseButton"
                            Variant="Secondary"
                            Size="Small"
                            Width="28" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnFontSizeDecreaseClick">
                  <lucide:LucideIcon Kind="Minus" Size="13" Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </arc:Button>
                <TextBlock x:Name="FontSizeText"
                           Text="16"
                           Width="24"
                           TextAlignment="Center"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                           VerticalAlignment="Center" />
                <arc:Button x:Name="FontSizeIncreaseButton"
                            Variant="Secondary"
                            Size="Small"
                            Width="28" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OnFontSizeIncreaseClick">
                  <lucide:LucideIcon Kind="Plus" Size="13" Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </arc:Button>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="56,*">
              <TextBlock x:Name="LineSpacingLabelText"
                         Text="行距"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                         VerticalAlignment="Center" />
              <arc:Select x:Name="LineSpacingSelect"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Size="Small"
                          SelectionChanged="OnLineSpacingChanged" />
            </Grid>

            <Grid ColumnDefinitions="56,*">
              <TextBlock x:Name="ThemeLabelText"
                         Text="主题"
                         FontSize="{arc:ArcDesignTokenResource TypeXS}"
                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                         VerticalAlignment="Center" />
              <arc:Select x:Name="ThemeSelect"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Size="Small"
                          SelectionChanged="OnThemeChanged" />
            </Grid>

            <TextBlock x:Name="PageOpacityText"
                       Text="窗体透明度 90% · Ctrl + 滚轮调整"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <arc:Button x:Name="TocButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnTocClick">
                <lucide:LucideIcon Kind="List" Size="15" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>
              <arc:Button x:Name="BookmarkButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnBookmarkClick">
                <lucide:LucideIcon Kind="Bookmark" Size="15" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>
              <arc:Button x:Name="NotesButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnNotesClick">
                <lucide:LucideIcon Kind="StickyNote" Size="15" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>
              <Border Width="1" Height="18"
                      Margin="4,0"
                      Background="{arc:ArcDesignTokenResource Border}"
                      VerticalAlignment="Center" />
              <arc:Button x:Name="SettingsButton"
                          Variant="Secondary"
                          Size="Small"
                          Width="36" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnSettingsToggleClick">
                <TextBlock Text="Aa" FontSize="13" FontWeight="SemiBold" />
              </arc:Button>
              <arc:ActionSwap x:Name="CloseOnOutsideAction"
                              Size="Small"
                              Width="36" Height="36"
                              Padding="0"
                              Margin="2,0,0,0"
                              VerticalAlignment="Center"
                              ValueChanged="OnCloseOnOutsideValueChanged">
                <arc:ActionSwap.States>
                  <arc:ActionSwapState Id="on"
                                       Icon="{lucide:LucideGeometry Kind=MousePointerClick}"
                                       Tone="Accent" />
                  <arc:ActionSwapState Id="off"
                                       Icon="{lucide:LucideGeometry Kind=MousePointer2Off}"
                                       Tone="Quiet" />
                </arc:ActionSwap.States>
              </arc:ActionSwap>
              <arc:ActionSwap x:Name="ImageMenuAction"
                              Size="Small"
                              Width="36" Height="36"
                              Padding="0"
                              Margin="2,0,0,0"
                              VerticalAlignment="Center"
                              Value="closed"
                              ValueChanged="OnImageMenuValueChanged">
                <arc:ActionSwap.States>
                  <arc:ActionSwapState Id="closed"
                                       Icon="{lucide:LucideGeometry Kind=Image}"
                                       Tone="Quiet" />
                  <arc:ActionSwapState Id="open"
                                       Icon="{lucide:LucideGeometry Kind=Image}"
                                       Tone="Accent" />
                </arc:ActionSwap.States>
              </arc:ActionSwap>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <arc:Button x:Name="PrevChapterButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnPrevChapterClick">
                <lucide:LucideIcon Kind="ChevronsLeft" Size="15" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>
              <arc:Button x:Name="PrevPageButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnPrevPageClick">
                <lucide:LucideIcon Kind="ChevronLeft" Size="16" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>

              <arc:Button x:Name="NextPageButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnNextPageClick">
                <lucide:LucideIcon Kind="ChevronRight" Size="16" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>
              <arc:Button x:Name="NextChapterButton"
                          Variant="Ghost"
                          Size="Small"
                          Width="30" Height="30"
                          Padding="0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Click="OnNextChapterClick">
                <lucide:LucideIcon Kind="ChevronsRight" Size="15" Foreground="{arc:ArcDesignTokenResource Foreground}" />
              </arc:Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <primitives:Popup x:Name="ImageSettingsPopup"
                        IsOpen="False"
                        IsLightDismissEnabled="True"
                        Placement="Top"
                        VerticalOffset="-8"
                        Closed="OnImageSettingsPopupClosed">
        <Border Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="1"
                BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}"
                CornerRadius="10"
                Padding="10,8"
                MinWidth="168">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto" MinHeight="36">
              <TextBlock x:Name="ShowImagesLabel"
                         Text="展示图片"
                         FontSize="{arc:ArcDesignTokenResource TypeSM}"
                         Foreground="{arc:ArcDesignTokenResource Foreground}"
                         VerticalAlignment="Center" />
              <arc:ActionSwap x:Name="ShowImagesAction"
                              Grid.Column="1"
                              Size="Small"
                              Width="36" Height="36"
                              Padding="0"
                              Value="on"
                              ValueChanged="OnShowImagesValueChanged">
                <arc:ActionSwap.States>
                  <arc:ActionSwapState Id="on"
                                       Icon="{lucide:LucideGeometry Kind=Eye}"
                                       Tone="Accent" />
                  <arc:ActionSwapState Id="off"
                                       Icon="{lucide:LucideGeometry Kind=EyeOff}"
                                       Tone="Quiet" />
                </arc:ActionSwap.States>
              </arc:ActionSwap>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinHeight="36">
              <TextBlock x:Name="GrayscaleImagesLabel"
                         Text="默认黑白"
                         FontSize="{arc:ArcDesignTokenResource TypeSM}"
                         Foreground="{arc:ArcDesignTokenResource Foreground}"
                         VerticalAlignment="Center" />
              <arc:ActionSwap x:Name="GrayscaleImagesAction"
                              Grid.Column="1"
                              Size="Small"
                              Width="36" Height="36"
                              Padding="0"
                              Value="off"
                              ValueChanged="OnGrayscaleImagesValueChanged">
                <arc:ActionSwap.States>
                  <arc:ActionSwapState Id="on"
                                       Icon="{lucide:LucideGeometry Kind=Contrast}"
                                       Tone="Accent" />
                  <arc:ActionSwapState Id="off"
                                       Icon="{lucide:LucideGeometry Kind=Palette}"
                                       Tone="Quiet" />
                </arc:ActionSwap.States>
              </arc:ActionSwap>
            </Grid>
          </StackPanel>
        </Border>
      </primitives:Popup>

      <!-- 阅读器目录/书签/批注列表 -->
      <Border x:Name="ReaderListOverlay"
              Grid.Row="1"
              IsVisible="False"
              Background="{arc:ArcDesignTokenResource SurfaceRaised}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="18,4,10,4">
            <TextBlock x:Name="ReaderListTitle"
                       Text="目录"
                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                       FontWeight="SemiBold"
                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <arc:Button x:Name="ReaderListCloseButton"
                        Grid.Column="1"
                        Variant="Ghost"
                        Size="Small"
                        Width="30" Height="30"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnReaderListCloseClick">
              <lucide:LucideIcon Kind="X" Size="16" Foreground="{arc:ArcDesignTokenResource Foreground}" />
            </arc:Button>
          </Grid>
          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ReaderListHost" Margin="10,0,10,8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    </Grid>
  </Border>
</UserControl>
