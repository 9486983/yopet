<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arcp="clr-namespace:TKCode.Arc.Primitives;assembly=TKCode.Arc.Core"
             x:Class="yopet.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="arcp|ArcPopup">
      <Setter Property="PopupRootShadow" Value="none" />
      <Setter Property="OverlayHostShadow" Value="none" />
    </Style>
  </Application.Styles>
</Application>
