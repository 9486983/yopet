<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="yopet.Views.PetdexDialog"
        x:CompileBindings="False"
        Title="宠物图鉴"
        Width="420"
        Height="500"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Border CornerRadius="16"
          Background="{DynamicResource BgOverlay}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1"
          Margin="8"
          BoxShadow="0 4 20 #40000000">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
      <!-- 标题 + 刷新 + 关闭 -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="🎮 Petdex 宠物"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   VerticalAlignment="Center" />
        <Button x:Name="ReloadBtn"
                Classes="flat"
                Grid.Column="1"
                Content="🔄"
                Width="32" Height="32"
                FontSize="14"
                Foreground="{DynamicResource TextMuted}"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                CornerRadius="8"
                Margin="0,0,4,0" />
        <Button x:Name="CloseBtn"
                Classes="flat"
                Grid.Column="2"
                Content="✕"
                Width="32" Height="32"
                FontSize="14"
                Foreground="{DynamicResource TextMuted}"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                CornerRadius="8" />
      </Grid>

      <!-- 安装命令输入框 -->
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <TextBox x:Name="InstallInput"
                 PlaceholderText="npx petdex install &lt;宠物名&gt;"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="{DynamicResource BgPage}"
                 BorderBrush="{DynamicResource BorderColor}"
                 CornerRadius="8"
                 FontSize="12"
                 Padding="8,6" />
        <Button x:Name="InstallBtn"
                Grid.Column="1"
                Content="⏬ 安装"
                Margin="6,0,0,0"
                CornerRadius="8"
                Background="{DynamicResource AccentPrimary}"
                BorderThickness="0"
                FontSize="12"
                Foreground="{DynamicResource TextPrimary}"
                Cursor="Hand"
                Padding="10,6" />
      </Grid>

      <!-- 安装状态 -->
      <TextBlock x:Name="InstallStatus"
                 Grid.Row="1"
                 FontSize="11"
                 Foreground="{DynamicResource TextMuted}"
                 Margin="0,30,0,0"
                 TextWrapping="Wrap"
                 IsVisible="False" />

      <!-- 宠物网格 -->
      <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
        <StackPanel Spacing="8">
          <TextBlock x:Name="PetdexHint"
                     Text="暂无已安装的宠物"
                     FontSize="12"
                     Foreground="{DynamicResource TextMuted}"
                     TextWrapping="Wrap" />
          <WrapPanel x:Name="PetGrid" />
        </StackPanel>
      </ScrollViewer>

      <!-- 底部提示 -->
      <TextBlock Grid.Row="3"
                 Text="💡 点击选择 · 在上方输入框直接安装新宠物"
                 FontSize="11"
                 Foreground="{DynamicResource TextFaint}"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,0" />
    </Grid>
  </Border>
</Window>
