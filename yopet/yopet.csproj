<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Lang.Avalonia" Version="12.1.1.2" />
    <PackageReference Include="Lang.Avalonia.Json" Version="12.1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="I18n\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\yopet.Core\yopet.Core.csproj" />
    <ProjectReference Include="..\yopet.Services\yopet.Services.csproj" />
    <ProjectReference Include="..\yopet.ViewModels\yopet.ViewModels.csproj" />
    <ProjectReference Include="..\yopet.Sdk\yopet.Sdk.csproj" />
    <ProjectReference Include="..\yopet.UI\yopet.UI.csproj" />
  </ItemGroup>
</Project>
