<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="https://codewf.com"
        xmlns:controls="clr-namespace:yopet.Controls"
        xmlns:ui="clr-namespace:yopet.UI.Components"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        x:Class="yopet.PetWindow"
        x:CompileBindings="False"
        Title="{c:I18n Localization.App.Title}"
        Width="160" MinWidth="120"
        Height="160" MinHeight="120"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        PointerPressed="OnWindowPointerPressed"
        PointerMoved="OnWindowPointerMoved"
        PointerReleased="OnWindowPointerReleased"
        PointerEntered="OnPetPointerEntered"
        PointerExited="OnPetPointerExited"
        DragDrop.AllowDrop="True">

  <Grid DragDrop.AllowDrop="True"
        DragDrop.DragEnter="OnDragEnter"
        DragDrop.DragOver="OnDragOver"
        DragDrop.DragLeave="OnDragLeave"
        DragDrop.Drop="OnDrop">
    <!-- 统一外部气泡（替代内部气泡 + 旧 Popup） -->
    <Popup x:Name="BubblePopup"
           Placement="Top"
           PlacementTarget="{Binding ElementName=PetBody}"
           IsOpen="{Binding IsAnyBubbleVisible}"
           HorizontalOffset="0"
           VerticalOffset="-8"
           WindowManagerAddShadowHint="False">
      <Grid RowDefinitions="Auto,18">
        <ui:ArcSurface Grid.Row="0"
                       Padding="14,8"
                       MaxWidth="220">
          <StackPanel>
            <!-- Reaction 模式：大号 emoji -->
            <TextBlock Text="{Binding CurrentReaction}"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsReacting}" />
            <!-- Thought 模式：助理名 + 文字 -->
            <Grid IsVisible="{Binding IsShowingThought}">
              <Grid RowDefinitions="Auto,Auto">
                <Grid ColumnDefinitions="Auto,*">
                  <Grid Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center">
                    <TextBlock Text="💬" FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ThoughtTitleIcon}"
                               FontSize="9"
                               Foreground="{arc:ArcDesignTokenResource Accent}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-1,-1" />
                  </Grid>
                  <TextBlock Grid.Column="1"
                             Text="{Binding ThoughtTitleText}"
                             FontSize="10" FontWeight="Bold"
                             Foreground="{arc:ArcDesignTokenResource Accent}"
                             VerticalAlignment="Center" />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding ThoughtText}"
                           FontSize="11" Foreground="{arc:ArcDesignTokenResource Foreground}"
                           TextWrapping="Wrap" MaxHeight="160" Margin="0,4,0,0" />
              </Grid>
            </Grid>
          </StackPanel>
        </ui:ArcSurface>

        <!-- 漫画气泡的小尾巴：向右移动，尖端反向左弯 -->
        <Grid Grid.Row="1" Width="20" Height="17"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,-2,0,0" IsHitTestVisible="False">
          <Grid.RenderTransform>
            <TranslateTransform X="18" />
          </Grid.RenderTransform>
          <Path Data="M 20,0 C 17,3 10,8 4,17 C 4,10 2,5 0,0 Z"
                Fill="{arc:ArcDesignTokenResource SurfaceRaised}"
                Stretch="None" />
          <Path Data="M 20,0 C 17,3 10,8 4,17 C 4,10 2,5 0,0"
                Stroke="{arc:ArcDesignTokenResource Border}"
                StrokeThickness="1"
                Stretch="None" />
        </Grid>
      </Grid>
    </Popup>


    <!-- 右上角状态区：💡 / 📋 或 进度环 -->
    <!-- 💡：普通激活无任务 ｜ 📋：会话中无任务 -->
    <Border Width="20" Height="20"
            IsVisible="{Binding IsIndicatorVisible}"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,16,16,0">
      <TextBlock Text="{Binding IndicatorText}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- 进度环：有任务执行中，点击取消 -->
    <Grid x:Name="RingGrid"
          Width="28" Height="28"
          IsVisible="{Binding IsTaskRunning}"
          HorizontalAlignment="Right" VerticalAlignment="Top"
          Margin="0,13,13,0"
          Cursor="Hand"
          ToolTip.Tip="{c:I18n Localization.PetWindow.CancelTaskTip}"
          Background="Transparent"
          PointerPressed="OnCancelTaskPointerPressed">
      <!-- 轨道背景圆圈（不拦截点击） -->
      <Ellipse Stroke="{arc:ArcDesignTokenResource AccentSubtle}" StrokeThickness="1"
               Width="20" Height="20"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsHitTestVisible="False" />
      <!-- 旋转圆点（不拦截点击） -->
      <Ellipse x:Name="RingDot" Fill="{arc:ArcDesignTokenResource Accent}"
               Width="4" Height="4"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               IsHitTestVisible="False" />
    </Grid>

    <!-- 宠物主体 -->
    <Border x:Name="PetBody"
            Width="100" Height="100"
            CornerRadius="50"
            Background="Transparent"
            PointerPressed="OnPetPointerPressed"
            ContextRequested="OnPetContextRequested">
      <controls:SpritesheetView x:Name="PetSprite"
                                Spritesheet="{Binding SpritesheetPath}"
                                CurrentRow="{Binding AnimCurrentRow}"
                                FrameWidth="{Binding AnimFrameWidth}"
                                FrameHeight="{Binding AnimFrameHeight}"
                                Columns="{Binding AnimColumns}"
                                Width="80" Height="80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
    </Border>

  </Grid>
</Window>
